# Front proxy for the telemt WEB proxy transport.
#
# Caddy terminates TLS for the public hostname, obtains and renews the
# certificate, and forwards every path to the loopback carrier listener.
# Only Caddy listens on a public interface.
#
# Install as /etc/caddy/Caddyfile and substitute the hostname:
#   sed -i 's/proxy\.example\.com/YOUR.HOSTNAME/g' /etc/caddy/Caddyfile
#   caddy validate --config /etc/caddy/Caddyfile --adapter caddyfile

{
	# Caddy's admin API otherwise listens on 127.0.0.1:2019 on every installed
	# host, and it can rewrite this configuration.
	admin off
	servers {
		# Without this Caddy also serves HTTP/3: it binds UDP/443 and appends
		# `Alt-Svc: h3=":443"` to every response including the bridge page,
		# advertising an endpoint no firewall recipe here opens.
		protocols h1 h2
		# read_header sheds a header slowloris at this hop, before it reaches
		# the relay's accept cap. read_body bounds a slow request body while
		# staying well above web.timeouts.long_poll_ms — it limits reading the
		# request, not the wait for the response, so parked polls are safe.
		timeouts {
			read_header 10s
			read_body 60s
		}
	}
}

proxy.example.com {
	# No `encode` and no Strict-Transport-Security, both deliberate. Compression
	# adds a length side-channel over the operator's own responses and halves the
	# amplitude of the relay's bridge-page padding; HSTS writes a permanent
	# "this device contacted this host" record into the client's HSTS store, a
	# device-side artefact a circumvention origin should not create. A valid
	# certificate and the automatic 80->443 redirect already cover the threat.

	# Every path goes to the relay: the bridge, the transport endpoints, and
	# the operator's own site are all served by telemt through one origin.
	# A separately hosted path would give an active prober something to
	# compare with the public site.
	reverse_proxy 127.0.0.1:8080 {
		# Long polls park for the configured web.timeouts.long_poll_ms
		# (25s by default) and WebSocket carriers stay open for the whole
		# session, so no read timeout may be shorter than that.
		#
		# Unbounded here is safe because telemt bounds the hop itself: it
		# applies its own per-request deadline derived from long_poll_ms
		# and body_read_ms, and its own connect and response deadlines for
		# web.public_upstream. Do not add a timeout shorter than
		# long_poll_ms in an attempt to bound it here — that only breaks
		# the downlink poll.
		transport http {
			read_timeout 0s
			write_timeout 0s
		}
	}

	# A stopped relay would otherwise answer with Caddy's own 502 page, which
	# names the server. This gives every path the same short body an ordinary
	# site returns while its backend is down; no path is special-cased.
	handle_errors {
		header {
			Cache-Control "no-store"
			Content-Security-Policy "default-src 'self'; style-src 'self'; img-src 'self'; worker-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'"
			Permissions-Policy "camera=(), microphone=(), geolocation=()"
			Referrer-Policy "strict-origin-when-cross-origin"
			X-Content-Type-Options "nosniff"
			X-Frame-Options "DENY"
		}
		respond "{http.error.status_code} {http.error.status_text}" {http.error.status_code}
	}
}

# Notes
#
# X-Forwarded-For needs no configuration here. Caddy discards inbound
# X-Forwarded-* values and sets the header to the address it observed, which is
# exactly what telemt's `web.trusted_proxies` expects. Do not add
# `header_up X-Forwarded-For` — Caddy warns that it is unnecessary.
#
# If a CDN fronts Caddy, telemt still matches the Host header against
# web.hostname, which must be the name clients type into their app. When the CDN
# rewrites Host to the origin name, normalise it back inside the site block:
#
#   header_up Host cdn.example.com
#
# Configuring Caddy's own `trusted_proxies` (only correct when something else
# already fronts Caddy) makes it forward inbound values and append its own, so
# the header becomes a list. telemt then accounts the request against the last
# entry, which is the address Caddy observed — the CDN, not the end user. The
# WEB transport is not designed to run behind a CDN; long polls and WebSocket
# carriers depend on unbuffered pass-through.
#
# Access logs go to the journal by default: `journalctl -u caddy -f`. Never
# enable request-header logging on this site — the session bearer travels in a
# header on the WebSocket upgrade. If you do want a log file, create the
# directory for Caddy first, otherwise the service fails to start with
# "permission denied":
#
#   mkdir -p /var/log/caddy && chown caddy:caddy /var/log/caddy
#
# and then add inside the site block:
#
#   log {
#       output file /var/log/caddy/proxy.example.com.log
#       format json
#   }
