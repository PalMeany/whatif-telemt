# Front proxy for the telemt WEB proxy transport, for a host that already
# runs nginx. Certificates come from certbot or your own automation.
#
# Install as /etc/nginx/sites-available/proxy.example.com and substitute the
# hostname and certificate paths.

server {
    listen 80;
    listen [::]:80;
    server_name proxy.example.com;

    # Keep the ACME path local; everything else moves to HTTPS.
    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    # nginx >= 1.25.1. On older builds drop this line and use
    # `listen 443 ssl http2;` instead. HTTP/2 matters for the lane carriers:
    # HTTP/1.1 per-origin connection limits constrain many parallel polls.
    http2 on;
    server_name proxy.example.com;

    ssl_certificate     /etc/letsencrypt/live/proxy.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/proxy.example.com/privkey.pem;

    # No gzip and no Strict-Transport-Security here, both deliberate.
    # Compression adds a length side-channel over the operator's own responses
    # and halves the amplitude of the relay's bridge-page padding; HSTS writes a
    # permanent "this device contacted this host" record into the client's HSTS
    # store, a device-side artefact a circumvention origin should not create.
    # A valid certificate and the redirect above already cover the threat.

    # No hostname-wide byte ceiling: one constant shared by every deployment is
    # measurable with an active probe, and the operator's own application picks
    # its per-route limits. Do not delete the line instead -- nginx then applies
    # its 1 MiB default and rejects carrier uplinks. The relay bounds those
    # itself with web.limits.max_body_bytes (2 MiB).
    client_max_body_size 0;

    # nginx's built-in error pages carry an <hr><center>nginx</center> banner,
    # so a stopped relay would announce the front proxy on every path. Answer
    # every failure with one short generic body instead. The client still sees
    # the original status: error_page without `=` keeps it, and the code on
    # `return` is then discarded. A named location rather than an internal
    # `location = /path`, which would answer that one path unlike every other.
    server_tokens off;
    error_page 400 408 414 431 500 502 503 504 @unavailable;
    location @unavailable {
        default_type text/plain;
        add_header Cache-Control          "no-store" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options        "DENY" always;
        add_header Referrer-Policy        "strict-origin-when-cross-origin" always;
        return 502 "Service temporarily unavailable\n";
    }

    # The bridge capability travels in the query string and the session bearer
    # in a request header on the WebSocket upgrade, so the default `combined`
    # format would write both to disk: it logs $request, which includes the
    # query. This format logs the path only and no headers. Never replace it
    # with `combined`, and never enable header logging for this server block.
    #
    # Define the format once, in the http { } block:
    #
    #   log_format telemt_web '$remote_addr - [$time_local] '
    #                         '"$request_method $uri $server_protocol" '
    #                         '$status $body_bytes_sent';
    #
    # If you would rather log nothing at all for this site, use:
    #
    #   access_log off;
    access_log /var/log/nginx/proxy.example.com.log telemt_web;

    # Every path goes to the relay: the bridge, the transport endpoints, and
    # the operator's own site are all served by telemt through one origin.
    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;

        proxy_set_header Host              $host;
        # $remote_addr, not $proxy_add_x_forwarded_for: nginx would otherwise
        # forward a client-supplied value and append its own, and telemt would
        # account the request against the last entry anyway.
        proxy_set_header X-Forwarded-For   $remote_addr;
        proxy_set_header X-Forwarded-Proto https;

        # WebSocket carriers.
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        # Long polls park for web.timeouts.long_poll_ms (25s by default) and
        # WebSocket carriers stay open for the whole session.
        proxy_read_timeout    1h;
        proxy_send_timeout    1h;
        proxy_buffering       off;
        proxy_request_buffering off;
    }
}

# Required once, in the http { } block, for the Connection header above:
#
# map $http_upgrade $connection_upgrade {
#     default upgrade;
#     ''      close;
# }
